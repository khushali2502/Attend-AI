# Database configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/attendai

# Authentication & Security
SECRET_KEY=change-to-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30

# Environment
ENVIRONMENT=development
PROJECT_NAME=AttendAI

# Optional AI / Service Integrations
GEMINI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=attendai-kb
REDIS_URL=
